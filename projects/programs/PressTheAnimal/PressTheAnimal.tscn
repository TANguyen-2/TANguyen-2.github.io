[node name="Description" type="Label" parent="." unique_id=1364690189]
custom_minimum_size = Vector2(10, 0)
layout_mode = 2
theme_type_variation = &"TextNormal"
text = "
Rules:
Click on the Specified Animal before the Timer runs out for each round.
Clicking on the Wrong Animal can result in a Penalty to the remaining time.


Each Animal has a Unique Behaviour:
PENGUIN
Falls asleep if not interacted with.
The screen darkens when it sleeps.
Clicking on it while it is asleep will not result in a penalty.

RACCOON
Swaps place with another animal on rounds when it must be clicked.

DOG
May sneeze when clicked on.
Each sneeze hides other animals in fur.
"
horizontal_alignment = 1
autowrap_mode = 2

